{
  "name": "salao-premium",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes vite@6 --host 0.0.0.0",
    "build": "npx --yes vite@6 build",
    "test:agenda": "node src/agenda/tests/run.js",
    "test:utils": "node src/utils/input-masks.test.js",
    "test:errors": "node src/utils/errors.test.js",
    "test:quotes": "node src/modules/quotes/quote-components.test.js",
    "test:comanda": "node src/modules/comanda/comanda-detail.test.js && node src/modules/comanda/comanda-operations.test.js",
    "test:cash": "node src/modules/cash/cash-dashboard.test.js && node src/modules/cash/cash-operations.test.js",
    "test:tenant": "node src/auth/tenant-context.test.js",
    "audit:structure": "node scripts/audit-code-structure.mjs",
    "test:all": "npm run test:utils && npm run test:errors && npm run test:quotes && npm run test:comanda && npm run test:cash && npm run test:tenant && npm run test:customer-auth && npm run test:customer-account && npm run test:customer-profile && npm run test:agenda && npm run audit:structure && npm run test:customer-services",
    "test:integration:backend": "node tests/integration/backend-flows.test.mjs",
    "test:customer-auth": "node cliente/auth-utils.test.js",
    "test:customer-account": "node cliente/customer-account.test.js",
    "test:customer-profile": "node cliente/customer-profile-utils.test.js",
    "test:customer-services": "node cliente/services/client-services.test.js"
  },
  "engines": {
    "node": ">=20"
  }
}
