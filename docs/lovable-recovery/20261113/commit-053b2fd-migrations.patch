@@ -0,0 +1,474 @@
+-- Migração 20261112165526 (professional_app_access_and_comanda_workflow) exportada do histórico aplicado no Supabase.
+-- Conteúdo idêntico ao registrado em supabase_migrations.schema_migrations; não editar.
+
+
+-- Professional app access metadata.
+alter table public.org_memberships
+  add column if not exists professional_app_enabled boolean not null default false,
+  add column if not exists professional_app_scope text not null default 'self';
+
+do $$
+begin
+  if not exists(select 1 from pg_constraint where conname='org_memberships_professional_app_scope_check') then
+    alter table public.org_memberships add constraint org_memberships_professional_app_scope_check
+      check (professional_app_scope in ('self','all'));
+  end if;
+end $$;
+create index if not exists org_memberships_app_access_idx
+  on public.org_memberships(org_id,user_id,professional_app_enabled,professional_app_scope);
+
+create or replace function private.professional_app_scope(target_org uuid)
+returns text language sql stable security definer set search_path=''
+as $$
+  select case
+    when m.role in ('owner','admin') then 'all'
+    when m.role='professional' and exists(
+      select 1 from public.professionals p
+       where p.org_id=m.org_id and p.profile_id=m.user_id
+         and p.active=true and p.access_enabled=true
+    ) then 'self'
+    when m.professional_app_enabled then m.professional_app_scope
+    else 'none'
+  end
+  from public.org_memberships m
+  where m.org_id=target_org and m.user_id=(select auth.uid()) and m.status='active'
+  limit 1;
+$$;
+revoke all on function private.professional_app_scope(uuid) from public,anon;
+grant execute on function private.professional_app_scope(uuid) to authenticated,service_role;
+
+-- Appointment to command relationship and lifecycle.
+alter table public.appointments
+  add column if not exists service_order_id uuid references public.service_orders(id),
+  add column if not exists comanda_strategy text not null default 'new_on_arrival',
+  add column if not exists arrived_at timestamptz,
+  add column if not exists completed_at timestamptz,
+  add column if not exists cancelled_at timestamptz;
+
+do $$
+begin
+  if not exists(select 1 from pg_constraint where conname='appointments_comanda_strategy_check') then
+    alter table public.appointments add constraint appointments_comanda_strategy_check
+      check (comanda_strategy in ('new_on_arrival','reuse_open'));
+  end if;
+end $$;
+
+alter table public.service_orders
+  add column if not exists sale_id uuid references public.sales(id),
+  add column if not exists closed_at timestamptz;
+
+alter table public.service_order_items
+  add column if not exists source_appointment_id uuid references public.appointments(id);
+
+alter table public.commissions
+  add column if not exists service_order_item_id uuid references public.service_order_items(id);
+
+create unique index if not exists service_order_items_source_appointment_unique
+  on public.service_order_items(source_appointment_id) where source_appointment_id is not null;
+create unique index if not exists commissions_order_item_unique
+  on public.commissions(org_id,service_order_item_id) where service_order_item_id is not null;
+create index if not exists appointments_org_starts_at_idx
+  on public.appointments(org_id,starts_at);
+create index if not exists appointments_professional_starts_at_idx
+  on public.appointments(org_id,professional_id,starts_at);
+create index if not exists appointments_service_order_idx
+  on public.appointments(org_id,service_order_id);
+create index if not exists service_orders_org_assignee_status_idx
+  on public.service_orders(org_id,assigned_professional_id,status,created_at desc);
+create index if not exists service_order_items_professional_idx
+  on public.service_order_items(org_id,professional_id,created_at desc);
+
+-- Multiple payments per command, with corresponding cash movements.
+create table if not exists public.service_order_payments (
+  id uuid primary key default gen_random_uuid(),
+  org_id uuid not null references public.organizations(id) on delete cascade,
+  order_id uuid not null references public.service_orders(id),
+  branch_id uuid references public.branches(id),
+  cash_register_id uuid references public.cash_registers(id),
+  cash_movement_id uuid references public.cash_movements(id),
+  amount numeric(12,2) not null check(amount>0),
+  payment_method text not null check(payment_method in ('cash','pix','credit_card','debit_card','transfer','voucher','other')),
+  status text not null default 'confirmed' check(status in ('confirmed','refunded','cancelled')),
+  paid_at timestamptz not null default now(),
+  created_by uuid,
+  created_at timestamptz not null default now()
+);
+create index if not exists service_order_payments_org_order_idx
+  on public.service_order_payments(org_id,order_id,paid_at);
+alter table public.service_order_payments enable row level security;
+drop policy if exists service_order_payments_select_admin_only on public.service_order_payments;
+create policy service_order_payments_select_admin_only
+  on public.service_order_payments for select to authenticated
+  using (
+    private.has_org_role(org_id,array['owner','admin','manager','finance'])
+    or private.professional_app_scope(org_id)='all'
+  );
+grant select on public.service_order_payments to authenticated;
+revoke insert,update,delete on public.service_order_payments from anon,authenticated;
