+
+
+create or replace function public.register_service_order_payment(p_order_id uuid,p_amount numeric,p_payment_method text)
+returns jsonb language plpgsql security definer set search_path=''
+as $$
+declare
+  v_order public.service_orders%rowtype; v_payment_id uuid; v_cash_id uuid; v_cash_movement_id uuid; v_sale_id uuid;
+  v_paid numeric; v_rate numeric; v_item record; v_product public.products%rowtype; v_user uuid:=(select auth.uid()); v_closed boolean:=false;
+begin
+  if v_user is null then raise exception 'Autenticação necessária.'; end if;
+  if p_amount is null or p_amount<=0 then raise exception 'Informe um valor válido.'; end if;
+  if p_payment_method not in ('cash','pix','credit_card','debit_card','transfer','voucher','other') then raise exception 'Forma de pagamento inválida.'; end if;
+  select * into v_order from public.service_orders where id=p_order_id for update;
+  if not found then raise exception 'Comanda não encontrada.'; end if;
+  if not (private.has_org_role(v_order.org_id,array['owner','admin','manager','receptionist']) or private.professional_app_scope(v_order.org_id)='all') then
+    raise exception 'Sem permissão para receber pagamento.';
+  end if;
+  if v_order.status in ('cancelled','closed') then raise exception 'Esta comanda não aceita pagamentos.'; end if;
+  if v_order.total<=0 then raise exception 'Adicione serviços ou produtos antes de receber.'; end if;
+
+  select coalesce(sum(amount),0) into v_paid
+    from public.service_order_payments
+   where org_id=v_order.org_id and order_id=v_order.id and status='confirmed';
+  if v_paid+p_amount>v_order.total+0.01 then raise exception 'O pagamento ultrapassa o saldo da comanda.'; end if;
+
+  select id into v_cash_id from public.cash_registers
+   where org_id=v_order.org_id and status='open'
+     and branch_id is not distinct from v_order.branch_id
+   order by opened_at desc limit 1;
+
+  insert into public.service_order_payments(org_id,order_id,branch_id,cash_register_id,amount,payment_method,status,paid_at,created_by)
+  values(v_order.org_id,v_order.id,v_order.branch_id,v_cash_id,p_amount,p_payment_method,'confirmed',now(),v_user)
+  returning id into v_payment_id;
+
+  insert into public.cash_movements(org_id,branch_id,cash_register_id,movement_type,category,description,amount,payment_method,created_by)
+  values(v_order.org_id,v_order.branch_id,v_cash_id,'income','service_order','Recebimento da comanda #'||v_order.order_number,p_amount,p_payment_method,v_user)
+  returning id into v_cash_movement_id;
+  update public.service_order_payments set cash_movement_id=v_cash_movement_id where id=v_payment_id;
+  v_paid:=v_paid+p_amount;
+
+  if v_paid+0.01>=v_order.total then
+    insert into public.sales(org_id,branch_id,customer_id,appointment_id,status,subtotal,discount,total,payment_method,notes,sold_at,created_by)
+    values(v_order.org_id,v_order.branch_id,v_order.customer_id,v_order.appointment_id,'paid',v_order.subtotal,v_order.discount,v_order.total,'multiple',
+      'Fechamento da comanda #'||v_order.order_number,now(),v_user)
+    returning id into v_sale_id;
+
+    for v_item in
+      select * from public.service_order_items
+       where org_id=v_order.org_id and order_id=v_order.id
+       order by created_at,id
+    loop
+      insert into public.sale_items(org_id,sale_id,product_id,service_id,description,quantity,unit_price,discount,total)
+      values(v_order.org_id,v_sale_id,v_item.product_id,v_item.service_id,v_item.description,
+        v_item.quantity,v_item.unit_price,v_item.discount,v_item.total);
+
+      if v_item.item_type='product' and v_item.product_id is not null then
+        select * into v_product from public.products where org_id=v_order.org_id and id=v_item.product_id for update;
+        if not found or v_product.stock_quantity<v_item.quantity then
+          raise exception 'Estoque insuficiente para o produto %.',v_item.description;
+        end if;
+        update public.products set stock_quantity=stock_quantity-v_item.quantity,updated_at=now()
+         where org_id=v_order.org_id and id=v_item.product_id;
+        insert into public.inventory_movements(org_id,branch_id,product_id,movement_type,quantity,unit_cost,reason,reference_id,created_by)
+        values(v_order.org_id,v_order.branch_id,v_item.product_id,'out',v_item.quantity,v_product.cost_price,
+          'Venda pela comanda #'||v_order.order_number,v_order.id,v_user);
+      elsif v_item.item_type='service' and v_item.professional_id is not null then
+        select cr.rate into v_rate from public.commission_rules cr
+         where cr.org_id=v_order.org_id and cr.active=true
+           and (cr.professional_id=v_item.professional_id or cr.professional_id is null)
+           and (cr.service_id=v_item.service_id or cr.service_id is null)
+         order by (cr.professional_id is not null) desc,(cr.service_id is not null) desc
+         limit 1;
+        if v_rate is null then
+          select commission_rate into v_rate from public.professionals
+           where org_id=v_order.org_id and id=v_item.professional_id;
+        end if;
+        insert into public.commissions(org_id,professional_id,sale_id,appointment_id,service_order_item_id,base_amount,rate,amount,status)
+        values(v_order.org_id,v_item.professional_id,v_sale_id,v_item.source_appointment_id,v_item.id,
+          greatest(v_item.total,0),coalesce(v_rate,0),round(greatest(v_item.total,0)*coalesce(v_rate,0)/100,2),'pending')
+        on conflict (org_id,service_order_item_id) where service_order_item_id is not null do nothing;
+      end if;
+    end loop;
+
+    update public.service_orders set status='closed',sale_id=v_sale_id,closed_at=now(),updated_at=now()
+     where org_id=v_order.org_id and id=v_order.id;
+    update public.appointments set status='completed',completed_at=coalesce(completed_at,now()),updated_at=now()
+     where org_id=v_order.org_id and service_order_id=v_order.id and status not in ('cancelled','completed');
+    v_closed:=true;
+  else
+    update public.service_orders set status='partially_paid',updated_at=now()
+     where org_id=v_order.org_id and id=v_order.id;
+  end if;
+
+  return jsonb_build_object('payment_id',v_payment_id,'cash_movement_id',v_cash_movement_id,'sale_id',v_sale_id,
+    'paid_total',v_paid,'balance',greatest(v_order.total-v_paid,0),'closed',v_closed);
+end;
+$$;
+revoke all on function public.register_service_order_payment(uuid,numeric,text) from public,anon;
+grant execute on function public.register_service_order_payment(uuid,numeric,text) to authenticated;

diff --git a/salao-premium/supabase/migrations/20261112173203_payment_safe_cancellation_and_security_cleanup.sql b/salao-premium/supabase/migrations/20261112173203_payment_safe_cancellation_and_security_cleanup.sql
new file mode 100644
@@ -0,0 +1,147 @@
+-- Migração 20261112173203 (payment_safe_cancellation_and_security_cleanup) exportada do histórico aplicado no Supabase.
+-- Conteúdo idêntico ao registrado em supabase_migrations.schema_migrations; não editar.
+
+
+-- Avoid recursive side effects and protect settled payments from silent cancellation.
+create or replace function private.sync_appointment_comanda_status()
+returns trigger
+language plpgsql
+security definer
+set search_path=''
+as $$
+begin
+  if new.status='cancelled' and old.status is distinct from new.status then
+    new.cancelled_at:=coalesce(new.cancelled_at,clock_timestamp());
+    if new.service_order_id is not null then
+      if exists(
+        select 1 from public.service_order_payments p
+        where p.org_id=new.org_id and p.order_id=new.service_order_id and p.status='confirmed'
+      ) then
+        raise exception 'Esta comanda já recebeu pagamento. Registre o estorno antes de cancelar o horário.';
+      end if;
+      if not exists(
+        select 1 from public.appointments other
+        where other.org_id=new.org_id and other.service_order_id=new.service_order_id
+          and other.id<>new.id and other.status not in ('cancelled','completed')
+      ) then
+        perform set_config('app.skip_comanda_appointment_sync','1',true);
+        update public.service_orders
+           set status='cancelled',updated_at=clock_timestamp()
+         where id=new.service_order_id and org_id=new.org_id and status not in ('cancelled','closed');
+        perform set_config('app.skip_comanda_appointment_sync','0',true);
+      end if;
+    end if;
+  elsif new.status='completed' and old.status is distinct from new.status then
+    new.completed_at:=coalesce(new.completed_at,clock_timestamp());
+  end if;
+  return new;
+end;
+$$;
+
+create or replace function private.sync_comanda_appointment_status()
+returns trigger
+language plpgsql
+security definer
+set search_path=''
+as $$
+begin
+  if new.status='cancelled' and old.status is distinct from new.status
+     and coalesce(current_setting('app.skip_comanda_appointment_sync',true),'0')<>'1' then
+    if exists(
+      select 1 from public.service_order_payments p
+      where p.org_id=new.org_id and p.order_id=new.id and p.status='confirmed'
+    ) then
+      raise exception 'Esta comanda já recebeu pagamento. Registre o estorno antes de cancelar.';
+    end if;
+    update public.appointments
+       set status='cancelled',cancelled_at=coalesce(cancelled_at,clock_timestamp()),updated_at=clock_timestamp()
+     where org_id=new.org_id and service_order_id=new.id
+       and status not in ('cancelled','completed');
+  end if;
+  return new;
+end;
+$$;
+
+create or replace function private.unlink_order_before_appointment_delete()
+returns trigger
+language plpgsql
+security definer
+set search_path=''
+as $$
+begin
+  if old.service_order_id is not null then
+    if exists(
+      select 1 from public.service_order_payments p
+      where p.org_id=old.org_id and p.order_id=old.service_order_id and p.status='confirmed'
+    ) then
+      raise exception 'Este agendamento possui comanda com pagamento. Faça o estorno antes de excluir.';
+    end if;
+    if not exists(
+      select 1 from public.appointments other
+      where other.org_id=old.org_id and other.service_order_id=old.service_order_id
+        and other.id<>old.id and other.status not in ('cancelled','completed')
+    ) then
+      perform set_config('app.skip_comanda_appointment_sync','1',true);
+      update public.service_orders
+         set status=case when status not in ('closed','cancelled') then 'cancelled' else status end,
+             appointment_id=null,updated_at=clock_timestamp()
+       where org_id=old.org_id and id=old.service_order_id;
+      perform set_config('app.skip_comanda_appointment_sync','0',true);
+    else
+      update public.service_orders set appointment_id=null,updated_at=clock_timestamp()
+       where org_id=old.org_id and appointment_id=old.id;
+    end if;
+  else
+    update public.service_orders set appointment_id=null,updated_at=clock_timestamp()
+     where org_id=old.org_id and appointment_id=old.id;
+  end if;
+  return old;
+end;
+$$;
+
+create or replace function private.recalculate_service_order_totals()
+returns trigger
+language plpgsql
+security definer
+set search_path=''
+as $$
+declare target_org uuid; target_order uuid; item_total numeric;
+begin
+  if tg_op='DELETE' then target_org:=old.org_id;target_order:=old.order_id;
+  else target_org:=new.org_id;target_order:=new.order_id; end if;
+  select coalesce(sum(i.total),0) into item_total
+    from public.service_order_items i
+   where i.org_id=target_org and i.order_id=target_order;
+  update public.service_orders o
+     set subtotal=item_total,total=greatest(item_total-o.discount,0),updated_at=clock_timestamp()
+   where o.org_id=target_org and o.id=target_order;
+  if tg_op='DELETE' then return old; end if;
+  return new;
+end;
+$$;
+revoke all on function private.recalculate_service_order_totals() from public,anon,authenticated;
+
+-- Consolidate the two profile read policies into one scoped policy.
+drop policy if exists profiles_select_org_admin on public.profiles;
+drop policy if exists profiles_select_self on public.profiles;
+create policy profiles_select_self_or_org_admin
+on public.profiles for select to authenticated
+using (
+  id=(select auth.uid())
+  or exists(
+    select 1 from public.org_memberships target
+    where target.user_id=profiles.id and target.status='active'
+      and private.has_org_role(target.org_id,array['owner','admin','manager'])
+  )
+);
+
+-- Keep only one copy of the repeated calendar/commission lookup indexes.
+drop index if exists public.appointments_org_starts_at_idx;
+drop index if exists public.appointments_professional_starts_at_idx;
+drop index if exists public.service_order_items_professional_idx;
+
+-- Payment foreign-key indexes for the new payment ledger.
+create index if not exists service_order_payments_order_id_idx on public.service_order_payments(order_id);
+create index if not exists service_order_payments_branch_id_idx on public.service_order_payments(branch_id);
+create index if not exists service_order_payments_cash_register_id_idx on public.service_order_payments(cash_register_id);
+create index if not exists service_order_payments_cash_movement_id_idx on public.service_order_payments(cash_movement_id);

