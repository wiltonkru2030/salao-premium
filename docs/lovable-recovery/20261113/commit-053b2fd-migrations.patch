+-- Migração 20261112173311 (commission_payout_schema_and_history) exportada do histórico aplicado no Supabase.
+-- Conteúdo idêntico ao registrado em supabase_migrations.schema_migrations; não editar.
+
+
+alter table public.commissions add column if not exists payout_id uuid;
+
+create table if not exists public.commission_payouts (
