diff --git a/salao-premium/supabase/migrations/20261112162202_service_order_total_recalculation.sql b/salao-premium/supabase/migrations/20261112162202_service_order_total_recalculation.sql
new file mode 100644
@@ -0,0 +1,32 @@
+-- Migração 20261112162202 (service_order_total_recalculation) exportada do histórico aplicado no Supabase.
+-- Conteúdo idêntico ao registrado em supabase_migrations.schema_migrations; não editar.
+
+
+create or replace function private.recalculate_service_order_totals()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare target_org uuid; target_order uuid;
+begin
+  target_org := coalesce(new.org_id, old.org_id);
+  target_order := coalesce(new.order_id, old.order_id);
+  update public.service_orders o
+     set subtotal = coalesce((
+           select sum(i.total) from public.service_order_items i
+           where i.org_id=target_org and i.order_id=target_order
+         ),0),
+         total = greatest(coalesce((
+           select sum(i.total) from public.service_order_items i
+           where i.org_id=target_org and i.order_id=target_order
+         ),0) - o.discount,0),
+         updated_at = now()
+   where o.org_id=target_org and o.id=target_order;
+  return coalesce(new,old);
+end;
+$$;
+drop trigger if exists service_order_items_recalculate_totals on public.service_order_items;
+create trigger service_order_items_recalculate_totals
+after insert or update or delete on public.service_order_items
+for each row execute function private.recalculate_service_order_totals();

diff --git a/salao-premium/supabase/migrations/20261112162406_fix_service_order_totals_trigger.sql b/salao-premium/supabase/migrations/20261112162406_fix_service_order_totals_trigger.sql
new file mode 100644
@@ -0,0 +1,34 @@
+-- Migração 20261112162406 (fix_service_order_totals_trigger) exportada do histórico aplicado no Supabase.
+-- Conteúdo idêntico ao registrado em supabase_migrations.schema_migrations; não editar.
+
+
+create or replace function private.recalculate_service_order_totals()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare target_org uuid; target_order uuid; item_total numeric;
+begin
+  if tg_op = 'DELETE' then
+    target_org := old.org_id;
+    target_order := old.order_id;
+  else
+    target_org := new.org_id;
+    target_order := new.order_id;
+  end if;
+
+  select coalesce(sum(i.total),0) into item_total
+  from public.service_order_items i
+  where i.org_id=target_org and i.order_id=target_order;
+
+  update public.service_orders o
+     set subtotal=item_total,
+         total=greatest(item_total-o.discount,0),
+         updated_at=now()
+   where o.org_id=target_org and o.id=target_order;
+
+  if tg_op = 'DELETE' then return old; end if;
+  return new;
+end;
+$$;

