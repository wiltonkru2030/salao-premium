+"%").order("name").limit(8);if(error)throw error;return data||[];},
+   getLabel:item=>item.name+
+" · "+currency(item.sale_price)+
+" · Estoque: "+Number(item.stock_quantity||0),
+   onSelect:item=>selectedProduct=item
