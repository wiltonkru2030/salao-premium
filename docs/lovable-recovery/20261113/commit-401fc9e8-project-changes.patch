+        </span>
+      </div>`).join("")
+    : '<div class="empty-state">Adicione os serviços para compor o orçamento.</div>';
+
+  const discountServiceOptions = services.map(service => `
+    <label class="setting-row">
+      <span>${esc(service.name)}</span>
+      <input type="checkbox" name="discount_service" value="${esc(service.id)}" ${discountRules.has(service.id) ? "checked" : ""}>
+      Permitir desconto
+    </label>`).join("");
+
+  return `
+    <section class="settings-card quote-builder-card">
+      <div class="section-title">
+        <div><h3>Novo orçamento</h3><small class="muted">Monte uma proposta com serviços e responsáveis individuais.</small></div>
+        <span class="status">Proposta comercial</span>
+      </div>
+      <label>Cliente
+        <input id="quote-customer-search" class="field" placeholder="Buscar por nome ou WhatsApp" autocomplete="off" value="${esc(selectedCustomer?.name || "")}">
+      </label>
+      <div id="quote-customer-results" class="quote-suggestions"></div>
+      <div id="quote-selected-customer">${customerSummary}</div>
+      <div id="quote-quick-customer" hidden>
+        <form id="quote-quick-customer-form" class="form-grid">
+          <label>Nome completo<input class="field" name="name" required maxlength="120"></label>
+          <label>WhatsApp<input class="field" name="phone" type="tel" required placeholder="(00) 00000-0000"></label>
+          <button class="btn primary" type="submit">Cadastrar e vincular</button>
+          <button class="btn secondary" type="button" id="quote-quick-cancel">Cancelar</button>
+        </form>
+      </div>
+      <div class="quote-item-entry">
+        <label>Serviço
+          <select class="field" id="quote-service"><option value="">Selecione um serviço</option>${serviceOptions}</select>
+        </label>
+        <label>Profissional
+          <select class="field" id="quote-professional" disabled><option value="">Selecione um serviço primeiro</option></select>
+        </label>
+        <label>Quantidade<input class="field" id="quote-quantity" type="number" min="1" step="1" value="1"></label>
+        <label>Tipo de desconto
+          <select class="field" id="quote-discount-mode">
+            <option value="percent">Percentual (%)</option>
+            <option value="fixed" ${allowFixedDiscount ? "" : "disabled"}>Valor (R$)</option>
+          </select>
+        </label>
+        <label>Desconto<input class="field" id="quote-discount" type="number" min="0" step="0.01" value="0"></label>
+        <button class="btn secondary" type="button" id="quote-add-item">＋ Adicionar serviço</button>
+      </div>
+      <div class="quote-items-list">${itemRows}</div>
+      <div class="quote-totals">
+        <div class="setting-row"><span>Subtotal</span><b>${money(subtotal)}</b></div>
+        <div class="setting-row"><span>Descontos</span><b>− ${money(discount)}</b></div>
+        <div class="setting-row quote-grand-total"><b>Valor final</b><strong>${money(total)}</strong></div>
+      </div>
+      <label>Validade do orçamento<input class="field" id="quote-valid-until" type="date"></label>
+      <label>Observações<textarea class="field" id="quote-notes" rows="2" maxlength="1000" placeholder="Informações adicionais para o cliente"></textarea></label>
+      <button class="btn primary" id="quote-save" type="button" ${!selectedCustomer || !items.length ? "disabled" : ""}>Gerar orçamento e deixar em análise</button>
+    </section>
+    <section class="settings-card" id="quote-discount-settings-card" ${canManageSettings ? "" : "hidden"}>
+      <div class="section-title">
