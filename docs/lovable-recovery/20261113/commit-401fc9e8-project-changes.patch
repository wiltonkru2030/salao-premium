+}
+.form-grid>.btn,.form-row>.btn{justify-self:start}
+.settings-card form .field{width:100%}
+.notice,.demo-note,.empty-state{
+  border-radius:7px;font-size:10px;line-height:1.6
+}
+.empty-state{
+  padding:25px 18px;border:1px dashed var(--sp-line-strong);
+  background:#fbfaf8;color:var(--sp-muted);text-align:center
+}
+.notice{padding:12px 15px;border:1px solid #e8e1d4;background:#faf8f3;color:#665a43}
+.demo-note{margin:0;padding:12px 17px;background:#faf9f6;color:var(--sp-muted)}
+.status{
