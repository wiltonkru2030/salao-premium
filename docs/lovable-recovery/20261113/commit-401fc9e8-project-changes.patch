+  outline:0;border-color:var(--sp-gold);box-shadow:var(--sp-focus)
+}
+.form-grid,.form-row{
+  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
+  align-items:end;gap:13px;padding:17px 19px
+}
+.form-grid>label,.form-row>label,.settings-card form>label{
+  display:grid;align-content:start;gap:7px;min-width:0;
