diff --git a/public/salao/src/styles/design-layout.css b/public/salao/src/styles/design-layout.css
new file mode 100644
@@ -0,0 +1,35 @@
+/* SALÃO PREMIUM — design system global
+   Uma única fonte de verdade para os módulos administrativos.
+   Ordem de carregamento: depois dos estilos estruturais e antes do HTML renderizado.
+*/
+:root{
+  color-scheme:light;
+  --sp-ink:#242320;
+  --sp-muted:#817e76;
+  --sp-soft:#f7f6f3;
+  --sp-paper:#fff;
+  --sp-line:#e9e6df;
+  --sp-line-strong:#dcd7cc;
+  --sp-gold:#a58b5c;
+  --sp-gold-soft:#f5f1e8;
+  --sp-green:#557963;
+  --sp-red:#a45e58;
+  --sp-radius:9px;
+  --sp-shadow:0 18px 55px rgba(25,22,16,.12);
+  --sp-focus:0 0 0 3px rgba(165,139,92,.15);
+  --sp-control-height:42px;
+  --sp-content:1440px;
+}
+*,*::before,*::after{box-sizing:border-box}
+html{min-height:100%;background:var(--sp-paper);scroll-behavior:smooth}
+body{
+  min-height:100vh;margin:0;background:var(--sp-paper);color:var(--sp-ink);
+  font-family:'Poppins',sans-serif;font-size:13px;line-height:1.5;
+  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility
+}
+button,input,select,textarea{font:inherit}
+button{color:inherit}
+a{color:inherit}
+::selection{background:#e9dfcb;color:#28251f}
+img{max-width:100%}
+

