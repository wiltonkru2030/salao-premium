+const statusName = value => ({
+  draft: "Rascunho",
+  pending: "Em análise",
+  accepted: "Aceito",
+  rejected: "Recusado",
+  expired: "Expirado",
+  cancelled: "Cancelado"
+})[value] || "Status não identificado";
+
+export function renderQuoteBuilder({ items, selectedCustomer, services, professionals, discountRules, maxDiscount, allowFixedDiscount, canManageSettings }) {
+  const subtotal = items.reduce((sum, item) => sum + item.quantity * item.price, 0);
+  const discount = items.reduce((sum, item) => sum + item.discount, 0);
+  const total = subtotal - discount;
+
+  const serviceOptions = services.map(service => `
+    <option value="${esc(service.id)}">${esc(service.name)} · ${money(service.price)}</option>
+  `).join("");
+
+  const customerSummary = selectedCustomer
+    ? `<div class="notice">Cliente vinculado: <b>${esc(selectedCustomer.name)}</b> · ${esc(selectedCustomer.phone || "WhatsApp não informado")}</div>`
+    : '<small class="muted">Selecione um cliente para continuar.</small>';
+
+  const itemRows = items.length
+    ? items.map((item, index) => `
+      <div class="setting-row">
+        <span>
+          <b>${esc(item.name)}</b>
+          <small>${item.quantity} × ${money(item.price)} · ${esc(item.professionalName || "Profissional a definir")}${item.discount ? " · Desconto " + money(item.discount) : " · Sem desconto"}</small>
